# Copy this file to .env for local development. Everything is optional.

# ── Storage ──────────────────────────────────────────────────────
# Accounts and saved API keys. With DATABASE_URL set (e.g. Railway Postgres) the server uses
# Postgres; otherwise it uses a SQLite file in DATA_DIR (default ./data).
# DATABASE_URL=postgres://user:pass@host:5432/db
# DATA_DIR=./data

# Secret used to encrypt players' saved API keys. Set a long random value in production and
# never change it (changing it makes previously saved keys unreadable).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# APP_SECRET=

# ── Shared server keys (optional) ────────────────────────────────
# Players normally save their OWN keys in their account (Account → API keys).
# Keys set here are shared by EVERY host on this server, so leave them empty on a public deployment.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# CEREBRAS_API_KEY=
# GEMINI_API_KEY=
# HF_TOKEN=

# Ollama on the same machine as the server: free and unlimited.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Any other OpenAI-compatible endpoint.
# CUSTOM_LLM_LABEL=My endpoint
# CUSTOM_LLM_BASE_URL=https://example.com/v1
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_MODELS=model-a,model-b

# Port for the game server (the Vite dev server proxies to it; Railway sets this for you).
# PORT=3001

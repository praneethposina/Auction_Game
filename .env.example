# Copy this file to .env and fill in any providers you want AI players to use.
# You only need ONE. Built-in bots work with no keys at all.

# Groq: free tier, no credit card, very fast. Recommended for LLM players.
# https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter: ":free" models cost nothing (20 req/min, 50 req/day; 1,000/day after a one-time $10 top-up).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Hugging Face Inference Providers: small monthly free credits, open-weight models.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Ollama running locally: free and unlimited, uses your own hardware.
# https://ollama.com/download   (then e.g. `ollama pull qwen3:8b`)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Any other OpenAI-compatible endpoint (Cerebras, Google Gemini, LM Studio, vLLM, ...).
# CUSTOM_LLM_LABEL=Cerebras
# CUSTOM_LLM_BASE_URL=https://api.cerebras.ai/v1
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_MODELS=model-a,model-b

# Port for the game server (the Vite dev server proxies to it).
# PORT=3001
